{
  "workbench.colorCustomizations": {
    "activityBar.background": "#511C1C",
    "titleBar.activeBackground": "#712727",
    "titleBar.activeForeground": "#FEFBFB",
    "titleBar.inactiveBackground": "#511C1C",
    "titleBar.inactiveForeground": "#FEFBFB",
    "statusBar.background": "#511C1C",
    "statusBar.foreground": "#FEFBFB",
    "statusBar.debuggingBackground": "#511C1C",
    "statusBar.debuggingForeground": "#FEFBFB",
    "statusBar.noFolderBackground": "#511C1C",
    "statusBar.noFolderForeground": "#FEFBFB"
  },
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit"
  },
  "prettier.enable": false,
  "tailwindCSS.lint.suggestCanonicalClasses": "ignore",
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  }
}